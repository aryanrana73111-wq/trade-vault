{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "email"]
    },
    "Dashboard": {
      "title": "Dashboard",
      "description": "A trading journal dashboard",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "currency": { "type": "string" },
        "startingBalance": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "createdAt"]
    },
    "Trade": {
      "title": "Trade",
      "description": "A single trade record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "number" },
        "market": { "type": "string" },
        "direction": { "type": "string", "enum": ["BUY", "SELL"] },
        "entry": { "type": "number" },
        "stopLoss": { "type": "number" },
        "takeProfit": { "type": "number" },
        "positionSize": { "type": "number" },
        "risk": { "type": "number" },
        "strategy": { "type": "string" },
        "session": { "type": "string" },
        "notes": { "type": "string" },
        "mistake": { "type": "string" },
        "learning": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "date", "market", "direction", "entry"]
    },
    "Strategy": {
      "title": "Strategy",
      "description": "A trading strategy",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "shortDescription": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Archived"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Extended user profile and trading preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "tradingStyle": { "type": "string" },
        "tradingExperience": { "type": "string" },
        "preferredMarkets": { "type": "string" },
        "preferredTradingSession": { "type": "string" },
        "defaultAccountType": { "type": "string" },
        "bio": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "onboardingCompleted": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "fullName", "email"]
    },
    "CalculatorHistory": {
      "title": "CalculatorHistory",
      "description": "Saved risk and position sizing calculations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "number" },
        "instrument": { "type": "string" },
        "assetClass": { "type": "string" },
        "direction": { "type": "string", "enum": ["BUY", "SELL"] },
        "accountBalance": { "type": "number" },
        "currency": { "type": "string" },
        "riskPercent": { "type": "number" },
        "riskAmount": { "type": "number" },
        "entry": { "type": "number" },
        "stopLoss": { "type": "number" },
        "takeProfit": { "type": "number" },
        "positionSize": { "type": "number" },
        "units": { "type": "number" },
        "contractSize": { "type": "number" },
        "riskRewardRatio": { "type": "number" },
        "estimatedLoss": { "type": "number" },
        "potentialProfit": { "type": "number" },
        "notionalValue": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "timestamp", "instrument", "direction", "entry", "stopLoss", "positionSize", "riskAmount"]
    },
    "LearningEntry": {
      "title": "LearningEntry",
      "description": "Trader daily learning, insights and mistake analysis",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "dashboardId": { "type": "string" },
        "date": { "type": "number" },
        "dateString": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "relatedTradeId": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "dashboardId", "date", "content", "category"]
    },
    "TradingRule": {
      "title": "TradingRule",
      "description": "Trading rules and discipline guidelines",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "dashboardId": { "type": "string" },
        "text": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string", "enum": ["Critical", "Important", "Optional"] },
        "status": { "type": "string", "enum": ["Active", "Paused"] },
        "isPinned": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "dashboardId", "text", "category", "priority", "status"]
    },
    "NewsUserSettings": {
      "title": "NewsUserSettings",
      "description": "User preferences, watchlists, notes, and progress for News Intelligence",
      "type": "object",
      "properties": {
        "timezone": { "type": "string" },
        "defaultImpactFilter": { "type": "string" },
        "defaultMode": { "type": "string" },
        "watchlistEventIds": { "type": "array", "items": { "type": "string" } },
        "bookmarkedArticleIds": { "type": "array", "items": { "type": "string" } },
        "learnedArticleIds": { "type": "array", "items": { "type": "string" } },
        "userNotes": { "type": "object" },
        "preEventNotificationMinutes": { "type": "number" }
      }
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Security audit logs for user account and data operations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "number" },
        "deviceInfo": { "type": "string" },
        "status": { "type": "string", "enum": ["success", "warning", "failed"] }
      },
      "required": ["id", "userId", "action", "timestamp"]
    },
    "Arena": {
      "title": "Arena",
      "description": "Trading competition arena",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "code": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "startDate": { "type": "number" },
        "endDate": { "type": "number" },
        "durationDays": { "type": "number" },
        "status": { "type": "string" },
        "state": { "type": "string" },
        "scoringMode": { "type": "string" },
        "startingMode": { "type": "string" },
        "privacyMode": { "type": "string" },
        "fairPlayMode": { "type": "string" },
        "timezone": { "type": "string" },
        "maxMembers": { "type": "number" },
        "minTrades": { "type": "number" },
        "memberIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name", "code", "ownerId", "createdAt", "startDate", "endDate"]
    },
    "CompetitionTrade": {
      "title": "CompetitionTrade",
      "description": "Shared trade projection in a competition arena",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "competitionId": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "number" },
        "market": { "type": "string" },
        "direction": { "type": "string" },
        "entry": { "type": "number" },
        "pnl": { "type": "number" },
        "rMultiple": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "competitionId", "userId", "date", "market", "direction", "entry"]
    }
  },
  "firestore": {
    "/arenas/{arenaId}": {
      "schema": { "$ref": "#/entities/Arena" },
      "description": "Competition arenas"
    },
    "/arenas/{arenaId}/shared_trades/{tradeId}": {
      "schema": { "$ref": "#/entities/CompetitionTrade" },
      "description": "Competition shared trade projections"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/users/{userId}/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "User security audit logs"
    },
    "/users/{userId}/newsSettings/{settingsId}": {
      "schema": { "$ref": "#/entities/NewsUserSettings" },
      "description": "News Intelligence preferences and notes"
    },
    "/users/{userId}/profile/{profileId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile details and preferences"
    },
    "/users/{userId}/dashboards/{dashboardId}": {
      "schema": { "$ref": "#/entities/Dashboard" },
      "description": "User's individual trading dashboards"
    },
    "/users/{userId}/dashboards/{dashboardId}/trades/{tradeId}": {
      "schema": { "$ref": "#/entities/Trade" },
      "description": "Trades belonging to a dashboard"
    },
    "/users/{userId}/dashboards/{dashboardId}/strategies/{strategyId}": {
      "schema": { "$ref": "#/entities/Strategy" },
      "description": "Strategies belonging to a dashboard"
    },
    "/users/{userId}/dashboards/{dashboardId}/calculatorHistory/{historyId}": {
      "schema": { "$ref": "#/entities/CalculatorHistory" },
      "description": "Saved risk calculations for a dashboard"
    },
    "/users/{userId}/dashboards/{dashboardId}/learnings/{learningId}": {
      "schema": { "$ref": "#/entities/LearningEntry" },
      "description": "Trader daily learning and reflections"
    },
    "/users/{userId}/dashboards/{dashboardId}/rules/{ruleId}": {
      "schema": { "$ref": "#/entities/TradingRule" },
      "description": "Trading rules and discipline checklist"
    }
  }
}
